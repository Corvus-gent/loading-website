{
  "schemaVersion": 1,
  "runtime": "plethora-bit@2",
  "entry": "main.js",
  "title": "OSSMAN",
  "description": "Pac-Man in an octagon: you're a white belt submitting meme fighters. Swipe, collect techniques, grab a black belt and climb the ranks.",
  "tags": [
    "arcade",
    "mma",
    "pixel-art",
    "score"
  ],
  "permissions": [
    "audio",
    "storage"
  ],
  "dependencies": [],
  "display": "fullscreen",
  "onboarding": {
    "kind": "immersive",
    "version": 1
  },
  "memory": {
    "records": {
      "score": {
        "label": "Fight score",
        "valueType": "number",
        "order": "desc",
        "format": "integer",
        "periods": [
          "all_time",
          "daily"
        ],
        "scopes": [
          "global"
        ],
        "dedupe": "best_per_user"
      }
    }
  },
  "tuning": {
    "schemaVersion": 1,
    "knobs": {
      "player_speed": {
        "type": "number",
        "label": "Fighter speed",
        "default": 5,
        "min": 3,
        "max": 7,
        "apply": "restart"
      },
      "power_seconds": {
        "type": "number",
        "label": "Black belt duration",
        "default": 6,
        "min": 4,
        "max": 10,
        "apply": "restart"
      },
      "round_speed": {
        "type": "number",
        "label": "Enemy speed per round",
        "default": 1.15,
        "min": 1,
        "max": 1.3,
        "apply": "restart"
      }
    }
  }
}
