    columns: 6,
    align: center,
    table.header([distance], [0], [1], [2], [3], [4]),
    [states], [1], [18], [243], [3,240], [43,239],
  ),
  caption: [States at exact half-turn distance from solved. Distance 0 is the solved state.],
