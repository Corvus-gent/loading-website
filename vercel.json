{
  "regions": [
    "fra1"
  ],
  "redirects": [
    {
      "source": "/gabe",
      "destination": "/people/?id=gabe",
      "permanent": false
    },
    {
      "source": "/gabriel",
      "destination": "/people/?id=gabe",
      "permanent": true
    },
    {
      "source": "/links",
      "destination": "/links/gabe",
      "permanent": false
    },
    {
      "source": "/cv/gabriel.pdf",
      "destination": "/cv",
      "permanent": true
    },
    {
      "source": "/self",
      "destination": "/?utm_source=self&utm_medium=share&utm_campaign=home-share",
      "permanent": false
    }
  ],
  "rewrites": [
    {
      "source": "/r/:code/games",
      "destination": "/api/army?ref=:code&to=games"
    },
    {
      "source": "/r/:code",
      "destination": "/api/army?ref=:code"
    },
    {
      "source": "/soldier/:username/og.png",
      "destination": "/api/army?profile=:username&image=1"
    },
    {
      "source": "/soldier/:username/poster.png",
      "destination": "/api/army?profile=:username&image=1&poster=1"
    },
    {
      "source": "/soldier/:username",
      "destination": "/api/army?profile=:username&html=1"
    },
    {
      "source": "/join-the-army-now/:platform/:campaign",
      "destination": "/join-the-army-now/index.html"
    },
    {
      "source": "/api/report.md",
      "destination": "/api/stats?report=1"
    },
    {
      "source": "/api/notice-ok",
      "destination": "/api/stats?notice=1"
    },
    {
      "source": "/api/health/history",
      "destination": "/api/stats?healthHistory=1"
    },
    {
      "source": "/api/health",
      "destination": "/api/stats?health=1"
    },
    {
      "source": "/api/sf",
      "destination": "/api/stats?sf=1"
    },
    {
      "source": "/api/hit",
      "destination": "/api/stats?hit=1"
    },
    {
      "source": "/games/data/:path*",
      "destination": "/404.html"
    },
    {
      "source": "/api/game/:path*",
      "destination": "/api/stats?game=1"
    },
    {
      "source": "/api/game",
      "destination": "/api/stats?game=1"
    },
    {
      "source": "/cv",
      "destination": "/api/cv"
    },
    {
      "source": "/cv/download",
      "destination": "/api/cv?dl=1"
    },
    {
      "source": "/go/:path*",
      "destination": "/go/index.html"
    },
    {
      "source": "/links/corvus/:path*",
      "destination": "/links/corvus/index.html"
    },
    {
      "source": "/links/pidgy/:path*",
      "destination": "/links/pidgy/index.html"
    },
    {
      "source": "/links/:path+",
      "destination": "/links/index.html"
    }
  ],
  "functions": {
    "api/cv.js": {
      "includeFiles": "cv/**"
    },
    "api/music.js": {
      "includeFiles": "music.json"
    },
    "api/music-admin.js": {
      "includeFiles": "music.json"
    },
    "api/stats.js": {
      "includeFiles": "music.json",
      "maxDuration": 60
    },
    "api/x-stats.js": {
      "maxDuration": 60
    },
    "api/army.js": {
      "includeFiles": "{soldier/index.html,js/i18n/mail.*.json,js/i18n/army.*.json,img/army/fonts/**}",
      "maxDuration": 60
    },
    "api/discord.js": {
      "includeFiles": "js/i18n/army.*.json"
    }
  },
  "headers": [
    {
      "source": "/(.*)",
      "headers": [
        {
          "key": "Referrer-Policy",
          "value": "no-referrer"
        }
      ]
    },
    {
      "source": "/js/:path*",
      "has": [
        {
          "type": "query",
          "key": "v",
          "value": "[a-f0-9]{12}"
        }
      ],
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=31536000, immutable"
        }
      ]
    },
    {
      "source": "/js/army/:path*",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=0, must-revalidate"
        }
      ]
    },
    {
      "source": "/js/i18n/:path*",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=0, must-revalidate"
        }
      ]
    },
    {
      "source": "/styles.css",
      "has": [
        {
          "type": "query",
          "key": "v",
          "value": "[a-f0-9]{12}"
        }
      ],
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=31536000, immutable"
        }
      ]
    },
    {
      "source": "/games/:path*.css",
      "has": [
        {
          "type": "query",
          "key": "v",
          "value": "[a-f0-9]{12}"
        }
      ],
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=31536000, immutable"
        }
      ]
    },
    {
      "source": "/stats/:path*.css",
      "has": [
        {
          "type": "query",
          "key": "v",
          "value": "[a-f0-9]{12}"
        }
      ],
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=31536000, immutable"
        }
      ]
    },
    {
      "source": "/music/:path*.css",
      "has": [
        {
          "type": "query",
          "key": "v",
          "value": "[a-f0-9]{12}"
        }
      ],
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=31536000, immutable"
        }
      ]
    }
  ],
  "crons": [
    {
      "path": "/api/x-stats?cron=1",
      "schedule": "17 3 * * *"
    },
    {
      "path": "/api/stats?snapJob=1",
      "schedule": "12 2 * * *"
    },
    {
      "path": "/api/army?job=1",
      "schedule": "*/15 * * * *"
    }
  ],
  "buildCommand": "python3 tools/build-search.py"
}
