{
  "regions": [
    "fra1"
  ],
  "redirects": [
    {
      "source": "/livenow",
      "destination": "/live",
      "permanent": false
    },
    {
      "source": "/livenow/",
      "destination": "/live",
      "permanent": false
    },
    {
      "source": "/whitebelt",
      "destination": "/hack/play",
      "permanent": false
    },
    {
      "source": "/prize",
      "destination": "/compound",
      "permanent": false
    },
    {
      "source": "/1000",
      "destination": "/compound",
      "permanent": false
    },
    {
      "source": "/gabriel",
      "destination": "/people/?id=gabe",
      "permanent": true
    },
    {
      "source": "/links",
      "destination": "/links/gabe",
      "permanent": false
    },
    {
      "source": "/cv/gabriel.pdf",
      "destination": "/cv",
      "permanent": true
    },
    {
      "source": "/self",
      "destination": "/?utm_source=self&utm_medium=share&utm_campaign=home-share",
      "permanent": false
    }
  ],
  "rewrites": [
    {
      "source": "/api/legion",
      "destination": "/api/stats?legion=1"
    },
    {
      "source": "/api/legion/stripe",
      "destination": "/api/bmc-webhook?legionStripe=1"
    },
    {
      "source": "/legion/join/:token",
      "destination": "/legion/join/index.html"
    },
    {
      "source": "/api/compound/summary",
      "destination": "/api/stats?compoundSummary=1"
    },
    {
      "source": "/api/og",
      "destination": "/api/stats?og=1"
    },
    {
      "source": "/api/compound-v2",
      "destination": "/api/stats?compoundV2=1"
    },
    {
      "source": "/compound/v2/:lang(nl|en|fr|pt|es|de|it|ca|eu|tl|zh|tr|ar|ru|ce|pl|fa|ln|ay|qu)",
      "destination": "/compound/v2/index.html"
    },
    {
      "source": "/compound/v2/:lang(nl|en|fr|pt|es|de|it|ca|eu|tl|zh|tr|ar|ru|ce|pl|fa|ln|ay|qu)/",
      "destination": "/compound/v2/index.html"
    },
    {
      "source": "/compound/v2/:lang(nl|en|fr|pt|es|de|it|ca|eu|tl|zh|tr|ar|ru|ce|pl|fa|ln|ay|qu)/:hook(a|b|c|d|f|mom|bjj|startup|side|comm|int)",
      "destination": "/compound/v2/index.html"
    },
    {
      "source": "/compound/v2/:lang(nl|en|fr|pt|es|de|it|ca|eu|tl|zh|tr|ar|ru|ce|pl|fa|ln|ay|qu)/:hook(a|b|c|d|f|mom|bjj|startup|side|comm|int)/",
      "destination": "/compound/v2/index.html"
    },
    {
      "source": "/compound/v2/:lang(nl|en|fr|pt|es|de|it|ca|eu|tl|zh|tr|ar|ru|ce|pl|fa|ln|ay|qu)/:hook(a|b|c|d|f|mom|bjj|startup|side|comm|int)/:n([1-9][0-9]{0,3})",
      "destination": "/compound/v2/index.html"
    },
    {
      "source": "/compound/v2/:lang(nl|en|fr|pt|es|de|it|ca|eu|tl|zh|tr|ar|ru|ce|pl|fa|ln|ay|qu)/:hook(a|b|c|d|f|mom|bjj|startup|side|comm|int)/:n([1-9][0-9]{0,3})/",
      "destination": "/compound/v2/index.html"
    },
    {
      "source": "/api/live",
      "destination": "/api/stats?live=1"
    },
    {
      "source": "/api/build",
      "has": [
        {
          "type": "query",
          "key": "deployment",
          "value": "1"
        }
      ],
      "destination": "/api/bmc-webhook?buildDeployment=1"
    },
    {
      "source": "/api/build",
      "destination": "/api/stats?build=1"
    },
    {
      "source": "/api/build/og.png",
      "destination": "/api/stats?build=1&image=1"
    },
    {
      "source": "/api/support",
      "destination": "/api/stats?support=1"
    },
    {
      "source": "/plethora/stats.csv",
      "destination": "/api/stats?plethora=1&action=csv"
    },
    {
      "source": "/api/plethora",
      "destination": "/api/stats?plethora=1"
    },
    {
      "source": "/api/battle",
      "destination": "/api/stats?battle=1"
    },
    {
      "source": "/hack/play/do-bronx",
      "destination": "/hack/play/index.html"
    },
    {
      "source": "/hack/play/do-bronx/",
      "destination": "/hack/play/index.html"
    },
    {
      "source": "/api/name-vote",
      "destination": "/api/stats?nameVote=1"
    },
    {
      "source": "/hack/2",
      "destination": "/hack/index.html"
    },
    {
      "source": "/hack/2/",
      "destination": "/hack/index.html"
    },
    {
      "source": "/hack2",
      "destination": "/hack/index.html"
    },
    {
      "source": "/hack2/",
      "destination": "/hack/index.html"
    },
    {
      "source": "/api/compound/stripe",
      "destination": "/api/discord?compoundStripe=1"
    },
    {
      "source": "/api/compound",
      "destination": "/api/stats?compound=1"
    },
    {
      "source": "/api/hack",
      "destination": "/api/stats?hack=1"
    },
    {
      "source": "/r/:code/games",
      "destination": "/api/army?ref=:code&to=games"
    },
    {
      "source": "/r/:code",
      "destination": "/api/army?ref=:code"
    },
    {
      "source": "/soldier/:username/og.png",
      "destination": "/api/army?profile=:username&image=1"
    },
    {
      "source": "/soldier/:username/poster.png",
      "destination": "/api/army?profile=:username&image=1&poster=1"
    },
    {
      "source": "/soldier/:username",
      "destination": "/api/army?profile=:username&html=1"
    },
    {
      "source": "/join-the-army-now/:platform/:campaign",
      "destination": "/join-the-army-now/index.html"
    },
    {
      "source": "/api/report.md",
      "destination": "/api/stats?report=1"
    },
    {
      "source": "/api/notice-ok",
      "destination": "/api/stats?notice=1"
    },
    {
      "source": "/api/health/history",
      "destination": "/api/stats?healthHistory=1"
    },
    {
      "source": "/api/health",
      "destination": "/api/stats?health=1"
    },
    {
      "source": "/api/sf",
      "destination": "/api/stats?sf=1"
    },
    {
      "source": "/api/hit",
      "destination": "/api/stats?hit=1"
    },
    {
      "source": "/games/data/:path*",
      "destination": "/404.html"
    },
    {
      "source": "/api/game/:path*",
      "destination": "/api/stats?game=1"
    },
    {
      "source": "/api/game",
      "destination": "/api/stats?game=1"
    },
    {
      "source": "/cv/",
      "destination": "/api/cv"
    },
    {
      "source": "/cv",
      "destination": "/api/cv"
    },
    {
      "source": "/cv/download",
      "destination": "/api/cv?dl=1"
    },
    {
      "source": "/go/:path*",
      "destination": "/go/index.html"
    },
    {
      "source": "/links/corvus/:path*",
      "destination": "/links/corvus/index.html"
    },
    {
      "source": "/links/pidgy/:path*",
      "destination": "/links/pidgy/index.html"
    },
    {
      "source": "/links/:path+",
      "destination": "/links/index.html"
    }
  ],
  "functions": {
    "api/cv.js": {
      "includeFiles": "cv/**"
    },
    "api/music.js": {
      "includeFiles": "music.json"
    },
    "api/music-admin.js": {
      "includeFiles": "music.json"
    },
    "api/stats.js": {
      "includeFiles": "{music.json,battle/config.json,battle/media.json,hack/3/index.html,hack/3/interviews.json,live/index.html,compound/v2/index.html,public/gabe.jpg,img/army/fonts/DejaVuSansMono.ttf,api/_og/fonts/**}",
      "maxDuration": 60
    },
    "api/x-stats.js": {
      "maxDuration": 60
    },
    "api/army.js": {
      "includeFiles": "{soldier/index.html,js/i18n/mail.*.json,js/i18n/army.*.json,img/army/fonts/**}",
      "maxDuration": 60
    },
    "api/discord.js": {
      "includeFiles": "js/i18n/army.*.json"
    }
  },
  "headers": [
    {
      "source": "/(.*)",
      "headers": [
        {
          "key": "Referrer-Policy",
          "value": "no-referrer"
        }
      ]
    },
    {
      "source": "/js/:path*",
      "has": [
        {
          "type": "query",
          "key": "v",
          "value": "[a-f0-9]{12}"
        }
      ],
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=31536000, immutable"
        }
      ]
    },
    {
      "source": "/js/army/:path*",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=0, must-revalidate"
        }
      ]
    },
    {
      "source": "/js/i18n/:path*",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=0, must-revalidate"
        }
      ]
    },
    {
      "source": "/styles.css",
      "has": [
        {
          "type": "query",
          "key": "v",
          "value": "[a-f0-9]{12}"
        }
      ],
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=31536000, immutable"
        }
      ]
    },
    {
      "source": "/games/:path*.css",
      "has": [
        {
          "type": "query",
          "key": "v",
          "value": "[a-f0-9]{12}"
        }
      ],
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=31536000, immutable"
        }
      ]
    },
    {
      "source": "/stats/:path*.css",
      "has": [
        {
          "type": "query",
          "key": "v",
          "value": "[a-f0-9]{12}"
        }
      ],
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=31536000, immutable"
        }
      ]
    },
    {
      "source": "/music/:path*.css",
      "has": [
        {
          "type": "query",
          "key": "v",
          "value": "[a-f0-9]{12}"
        }
      ],
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=31536000, immutable"
        }
      ]
    },
    {
      "source": "/live.config.js",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=0, must-revalidate"
        }
      ]
    },
    {
      "source": "/admin/:path*",
      "headers": [
        {
          "key": "X-Robots-Tag",
          "value": "noindex, nofollow"
        },
        {
          "key": "Cache-Control",
          "value": "private, no-store"
        }
      ]
    }
  ],
  "crons": [
    {
      "path": "/api/x-stats?cron=1",
      "schedule": "17 3 * * *"
    },
    {
      "path": "/api/stats?snapJob=1",
      "schedule": "12 2 * * *"
    },
    {
      "path": "/api/army?job=1",
      "schedule": "*/15 * * * *"
    },
    {
      "path": "/api/stats?plethora=1&action=snapshot",
      "schedule": "0 7,8 * * *"
    },
    {
      "path": "/api/build?tick=1",
      "schedule": "19 * * * *"
    },
    {
      "path": "/api/compound-v2?reportJob=1",
      "schedule": "7,37 * * * *"
    }
  ],
  "buildCommand": "node tools/plethora/verify-routes.mjs && node tools/build-gabinho-rolls.mjs && node tools/build-battle.mjs && node tools/build-hackathons.mjs && node tools/build-plethora.mjs && python3 tools/build-search.py && node tools/site/build.mjs"
}
