{
  "redirects": [
    {
      "source": "/gabe",
      "destination": "/people/?id=gabe",
      "permanent": false
    },
    {
      "source": "/gabriel",
      "destination": "/people/?id=gabe",
      "permanent": true
    },
    {
      "source": "/links",
      "destination": "/links/gabe",
      "permanent": false
    },
    {
      "source": "/cv/gabriel.pdf",
      "destination": "/cv",
      "permanent": true
    },
    {
      "source": "/self",
      "destination": "/?utm_source=self&utm_medium=share&utm_campaign=home-share",
      "permanent": false
    }
  ],
  "rewrites": [
    {
      "source": "/games/data/:path*",
      "destination": "/404.html"
    },
    {
      "source": "/api/game/:path*",
      "destination": "/api/stats?game=1"
    },
    {
      "source": "/api/game",
      "destination": "/api/stats?game=1"
    },
    {
      "source": "/cv",
      "destination": "/api/cv"
    },
    {
      "source": "/cv/download",
      "destination": "/api/cv?dl=1"
    },
    {
      "source": "/go/:path*",
      "destination": "/go/index.html"
    },
    {
      "source": "/links/:path+",
      "destination": "/links/index.html"
    }
  ],
  "functions": {
    "api/cv.js": {
      "includeFiles": "cv/**"
    },
    "api/music.js": {
      "includeFiles": "music.json"
    },
    "api/music-admin.js": {
      "includeFiles": "music.json"
    },
    "api/stats.js": {
      "includeFiles": "{games/data/**,music.json}"
    }
  }
}
