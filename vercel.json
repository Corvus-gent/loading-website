{
  "regions": [
    "fra1"
  ],
  "redirects": [
    {
      "source": "/gabe",
      "destination": "/people/?id=gabe",
      "permanent": false
    },
    {
      "source": "/gabriel",
      "destination": "/people/?id=gabe",
      "permanent": true
    },
    {
      "source": "/links",
      "destination": "/links/gabe",
      "permanent": false
    },
    {
      "source": "/cv/gabriel.pdf",
      "destination": "/cv",
      "permanent": true
    },
    {
      "source": "/self",
      "destination": "/?utm_source=self&utm_medium=share&utm_campaign=home-share",
      "permanent": false
    }
  ],
  "rewrites": [
    {
      "source": "/api/dontpay",
      "destination": "/api/stats?dontpay=1"
    },
    {
      "source": "/arena",
      "destination": "/public/arena/index.html"
    },
    {
      "source": "/arena/:path*",
      "destination": "/public/arena/:path*"
    },
    {
      "source": "/api/hack",
      "destination": "/api/stats?hack=1"
    },
    {
      "source": "/api/health/history",
      "destination": "/api/stats?healthHistory=1"
    },
    {
      "source": "/api/health",
      "destination": "/api/stats?health=1"
    },
    {
      "source": "/api/sf",
      "destination": "/api/stats?sf=1"
    },
    {
      "source": "/api/hit",
      "destination": "/api/stats?hit=1"
    },
    {
      "source": "/games/data/:path*",
      "destination": "/404.html"
    },
    {
      "source": "/api/game/:path*",
      "destination": "/api/stats?game=1"
    },
    {
      "source": "/api/game",
      "destination": "/api/stats?game=1"
    },
    {
      "source": "/cv",
      "destination": "/api/cv"
    },
    {
      "source": "/cv/download",
      "destination": "/api/cv?dl=1"
    },
    {
      "source": "/go/:path*",
      "destination": "/go/index.html"
    },
    {
      "source": "/links/corvus/:path*",
      "destination": "/links/corvus/index.html"
    },
    {
      "source": "/links/pidgy/:path*",
      "destination": "/links/pidgy/index.html"
    },
    {
      "source": "/links/:path+",
      "destination": "/links/index.html"
    }
  ],
  "functions": {
    "api/cv.js": {
      "includeFiles": "cv/**"
    },
    "api/music.js": {
      "includeFiles": "music.json"
    },
    "api/music-admin.js": {
      "includeFiles": "music.json"
    },
    "api/stats.js": {
      "includeFiles": "music.json",
      "maxDuration": 60
    },
    "api/x-stats.js": {
      "maxDuration": 60
    }
  },
  "headers": [
    {
      "source": "/(.*)",
      "headers": [
        {
          "key": "Referrer-Policy",
          "value": "no-referrer"
        }
      ]
    },
    {
      "source": "/js/:path*",
      "has": [
        {
          "type": "query",
          "key": "v",
          "value": "[a-f0-9]{12}"
        }
      ],
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=31536000, immutable"
        }
      ]
    },
    {
      "source": "/styles.css",
      "has": [
        {
          "type": "query",
          "key": "v",
          "value": "[a-f0-9]{12}"
        }
      ],
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=31536000, immutable"
        }
      ]
    },
    {
      "source": "/games/:path*.css",
      "has": [
        {
          "type": "query",
          "key": "v",
          "value": "[a-f0-9]{12}"
        }
      ],
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=31536000, immutable"
        }
      ]
    },
    {
      "source": "/stats/:path*.css",
      "has": [
        {
          "type": "query",
          "key": "v",
          "value": "[a-f0-9]{12}"
        }
      ],
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=31536000, immutable"
        }
      ]
    },
    {
      "source": "/music/:path*.css",
      "has": [
        {
          "type": "query",
          "key": "v",
          "value": "[a-f0-9]{12}"
        }
      ],
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=31536000, immutable"
        }
      ]
    }
  ],
  "crons": [
    {
      "path": "/api/x-stats?cron=1",
      "schedule": "17 3 * * *"
    },
    {
      "path": "/api/stats?snapJob=1",
      "schedule": "12 2 * * *"
    }
  ],
  "buildCommand": "npm run build"
}
